{
  "name": "tybar-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "conferir-builds": "esbuild scripts/conferir_builds.ts --bundle --platform=node --format=esm --external:axios \"--define:import.meta.env={}\" --outfile=node_modules/.cache/conferir_builds.mjs --log-level=error && node node_modules/.cache/conferir_builds.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "axios": "^1.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}
